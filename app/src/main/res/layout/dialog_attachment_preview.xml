<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="22dp">

    <!-- Header: Title & Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/textPreviewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Attachment Preview"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text_primary"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/textPreviewType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Images"
            android:textColor="@color/tf_tag_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Image Content Preview -->
    <ImageView
        android:id="@+id/imagePreviewContent"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:scaleType="fitCenter"
        android:background="@color/tf_bg_screen"
        android:padding="8dp"
        android:visibility="gone"
        android:contentDescription="Image content preview" />

    <!-- Text Content Preview -->
    <ScrollView
        android:id="@+id/scrollTextPreview"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@color/tf_bg_screen"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textPreviewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tf_text_primary"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- Action Button (Inside card body) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/buttonPreviewClose"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Close"
            android:textColor="@color/white"
            android:backgroundTint="@color/tf_primary"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:paddingHorizontal="20dp" />
    </LinearLayout>

</LinearLayout>

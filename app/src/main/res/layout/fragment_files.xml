<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tf_bg_screen">

    <!-- Top Search & Type Filter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/tf_surface"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:elevation="1dp">

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search attachments"
                android:alpha="0.6" />

            <EditText
                android:id="@+id/editSearchAttachments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search attachment names..."
                android:textSize="13sp"
                android:textColor="@color/tf_text_primary"
                android:textColorHint="@color/tf_text_secondary"
                android:paddingHorizontal="8dp"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/buttonClearAttachmentSearch"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_close"
                android:contentDescription="Clear search"
                android:visibility="gone"
                android:alpha="0.5" />
        </LinearLayout>

        <!-- Type Filter Chips (All 3, Images 2, Text 1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chipFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="All 3"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipFilterImages"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Images 2"
                android:textColor="@color/tf_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipFilterText"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Text 1"
                android:textColor="@color/tf_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Showing X of Y Line -->
        <TextView
            android:id="@+id/textFilesShowingCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Showing 3 of 3 attachments"
            android:textColor="@color/tf_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listViewAttachments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="72dp"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />

        <!-- Empty State 1: No attachments in project -->
        <LinearLayout
            android:id="@+id/layoutEmptyNoAttachments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No attachments yet"
                android:textColor="@color/tf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Attach images or text documents from the catalog."
                android:textColor="@color/tf_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonEmptyAddAttachment"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:text="+ Add Attachment"
                android:backgroundTint="@color/tf_primary"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Empty State 2: No match for current search/chip -->
        <LinearLayout
            android:id="@+id/layoutEmptyNoFileMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No attachments match your search or type"
                android:textColor="@color/tf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Try searching for a different keyword or select All."
                android:textColor="@color/tf_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonEmptyResetFiles"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:text="Reset"
                android:backgroundTint="@color/tf_stroke"
                android:textColor="@color/tf_text_primary"
                android:textSize="13sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Floating Add Attachment Button -->
        <Button
            android:id="@+id/buttonFloatingAddAttachment"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="+ Add Attachment"
            android:backgroundTint="@color/tf_primary"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:elevation="6dp" />

    </FrameLayout>

</LinearLayout>

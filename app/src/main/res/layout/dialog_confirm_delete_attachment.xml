<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Remove Attachment"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/tf_text_primary"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/textDeleteInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To confirm removal, please type the exact attachment name below:"
        android:textColor="@color/tf_text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/textTargetAttachmentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="&quot;SampleName.png&quot;"
        android:textColor="@color/tf_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editConfirmAttachmentName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:hint="Type attachment name here..."
        android:textColorHint="@color/tf_text_secondary"
        android:textColor="@color/tf_text_primary"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textSize="14sp" />

    <!-- Action Buttons (Inside card body) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/buttonConfirmDeleteCancel"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Cancel"
            android:textColor="@color/tf_text_secondary"
            android:backgroundTint="@color/tf_bg_screen"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:paddingHorizontal="16dp" />

        <Button
            android:id="@+id/buttonConfirmDeleteRemove"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:text="Remove"
            android:textColor="@color/white"
            android:backgroundTint="@color/tf_overdue"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:paddingHorizontal="20dp" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create New Project"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="16dp" />

    <!-- Project Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Project Name *"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#555555" />

    <EditText
        android:id="@+id/editDialogProjectName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input_field"
        android:hint="Enter name (1–60 chars)"
        android:maxLength="60"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textSize="14sp" />

    <!-- Project Tag -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Project Tag *"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#555555" />

    <EditText
        android:id="@+id/editDialogProjectTag"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input_field"
        android:hint="e.g. MOBILE-APP, DESIGN (1–20 chars)"
        android:maxLength="20"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textSize="14sp" />

    <!-- Project Description -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Description *"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#555555" />

    <EditText
        android:id="@+id/editDialogProjectDescription"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|start"
        android:hint="Enter project description (1–500 chars)"
        android:maxLength="500"
        android:padding="12dp"
        android:textSize="14sp" />

    <!-- Optional Attachment Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Attachment (Optional)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#555555" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/buttonSelectAttachment"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Select from Catalog"
            android:textSize="12sp"
            android:backgroundTint="#F0F0F0"
            android:textColor="#333333"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/textSelectedAttachment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="None selected"
            android:textColor="#888888"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/buttonClearAttachment"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Remove selected attachment"
            android:visibility="gone"
            android:alpha="0.6" />
    </LinearLayout>

</LinearLayout>

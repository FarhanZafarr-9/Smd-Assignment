<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tf_bg_screen"
    tools:context=".HomeActivity">

    <!-- Top Workspace & Welcome Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/tf_surface"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="20dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_salutation"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_sub"
            android:textSize="14sp"
            android:textColor="@color/tf_text_secondary"
            android:layout_marginTop="2dp" />

        <!-- Workspace Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/tf_bg_screen"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/workspace_title"
                    android:textSize="12sp"
                    android:textColor="@color/tf_text_secondary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/workspace_name"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tf_text_primary"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/workspace_sub"
                        android:textSize="13sp"
                        android:textColor="@color/tf_text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/workspace_creation_date"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/tf_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/workspace_icon"
                android:contentDescription="@string/todo" />
        </LinearLayout>

        <!-- New Project Button -->
        <Button
            android:id="@+id/buttonNewProject"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="+ New Project"
            android:backgroundTint="@color/tf_primary"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_field"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search"
                android:alpha="0.6" />

            <EditText
                android:id="@+id/editSearchProjects"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search by project name or tag..."
                android:textSize="14sp"
                android:textColor="@color/tf_text_primary"
                android:textColorHint="@color/tf_text_secondary"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <ImageView
                android:id="@+id/buttonClearSearch"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_close"
                android:contentDescription="Clear search"
                android:visibility="gone"
                android:alpha="0.5" />
        </LinearLayout>

    </LinearLayout>

    <!-- Header for Projects section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/upcoming_projects"
            android:textSize="12sp"
            android:textColor="@color/tf_text_secondary"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/textProjectsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 Project"
            android:textSize="12sp"
            android:textColor="@color/tf_text_secondary" />
    </LinearLayout>

    <!-- Built-in ListView (must not sit inside a vertical ScrollView) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listViewProjects"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/emptyProjectsView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/no_projects"
            android:textColor="@color/tf_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>

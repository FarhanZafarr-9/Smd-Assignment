<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="12dp"
    android:background="?attr/selectableItemBackground">

    <RadioButton
        android:id="@+id/radioCatalogChoice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/tf_primary"
        android:clickable="false"
        android:focusable="false" />

    <ImageView
        android:id="@+id/imageCatalogIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_input"
        android:padding="6dp"
        android:src="@drawable/ic_image_file" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/textCatalogDisplayName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="File Name.png"
            android:textColor="@color/tf_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/textCatalogType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Images"
            android:textColor="@color/tf_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>

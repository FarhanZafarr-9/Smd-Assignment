<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="22dp">

    <TextView
        android:id="@+id/textTaskDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Task"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/tf_text_primary"
        android:layout_marginBottom="16dp" />

    <!-- Description Label & Live Counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Description *"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text_primary" />

        <TextView
            android:id="@+id/textTaskCharCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/500"
            android:textSize="12sp"
            android:textColor="@color/tf_text_secondary" />
    </LinearLayout>

    <EditText
        android:id="@+id/editTaskDescription"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|start"
        android:hint="Enter task description (1–500 chars)"
        android:textColorHint="@color/tf_text_secondary"
        android:textColor="@color/tf_text_primary"
        android:maxLength="500"
        android:padding="12dp"
        android:textSize="14sp" />

    <!-- Priority & Status Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Priority -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Priority"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/tf_text_primary" />

            <Spinner
                android:id="@+id/spinnerTaskPriority"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field" />
        </LinearLayout>

        <!-- Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/tf_text_primary" />

            <Spinner
                android:id="@+id/spinnerTaskStatus"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field" />
        </LinearLayout>
    </LinearLayout>

    <!-- Due Date Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Due Date (Optional)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/tf_text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/textSelectedDueDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No due date"
            android:textColor="@color/tf_text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/buttonPickDueDate"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Pick Date"
            android:textSize="11sp"
            android:backgroundTint="@color/tf_primary"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:paddingHorizontal="10dp" />

        <ImageView
            android:id="@+id/buttonClearDueDate"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Clear due date"
            android:visibility="gone"
            android:alpha="0.6" />
    </LinearLayout>

    <!-- Dialog Action Buttons (Inside card body) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/buttonTaskCancel"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Cancel"
            android:textColor="@color/tf_text_secondary"
            android:backgroundTint="@color/tf_bg_screen"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:paddingHorizontal="16dp" />

        <Button
            android:id="@+id/buttonTaskSave"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:text="Save"
            android:textColor="@color/white"
            android:backgroundTint="@color/tf_primary"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:paddingHorizontal="20dp" />
    </LinearLayout>

</LinearLayout>

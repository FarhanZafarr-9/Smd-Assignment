<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tf_bg_screen"
    tools:context=".ProjectActivity">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/tf_surface"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        android:paddingHorizontal="16dp"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/buttonBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/back_icon"
                android:contentDescription="Back"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/textProjectTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_tag"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="TAG"
                android:textColor="@color/tf_tag_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- UI-only Avatars & Invite -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp">

                <!-- Avatar 1 -->
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="F"
                    android:textColor="@color/tf_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <!-- Avatar 2 overlapping -->
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="Z"
                    android:textColor="@color/tf_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/buttonInvite"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="+ Invite"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Project Title in Header -->
        <TextView
            android:id="@+id/textProjectTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="Project Title"
            android:textColor="@color/tf_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- TabLayout: Horizontally Scrollable, No Clipped Labels -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabIndicatorColor="@color/tf_primary"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/tf_primary"
            app:tabTextColor="@color/tf_text_secondary"
            app:tabTextAppearance="@android:style/TextAppearance.Small"
            android:background="@color/tf_surface" />

    </LinearLayout>

    <!-- ViewPager2 for Fragments -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

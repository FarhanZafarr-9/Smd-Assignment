<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginTop="50dp"
    android:background="#fcfcfc"
    android:layout_marginHorizontal="25dp"
    tools:context=".ProductScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_icon"
            android:background="@drawable/bg_card_container"
            android:padding="6dp"
            android:contentDescription="@string/todo" />

        <View
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/card1InviteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_button"
            android:paddingHorizontal="25dp"
            android:paddingVertical="10dp"
            android:text="@string/project_action"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/card1Tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_pill"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:text="@string/project_type"
        android:textColor="#7B4FA3"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/project_screen_title"
        android:layout_marginTop="46dp"
        android:textSize="32sp"
        android:textAlignment="textStart"
        android:textColor="#121212"
        android:letterSpacing="0.01"
        android:id="@+id/projectScreenTitle"
        />

    <TextView
        android:id="@+id/card1Description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/project_description"
        android:textColor="#121212"
        android:alpha="0.85"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/attachments"
        android:textSize="14sp"
        android:textFontWeight="500"
        android:textColor="#121212"
        android:letterSpacing="0.05"
        android:layout_marginBottom="12dp"
        android:layout_marginTop="15dp"/>

    <LinearLayout
        android:id="@+id/attachmentsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/attachmentCard1"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:orientation="vertical"
            android:background="@drawable/bg_attachments"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/attachment_icon"
                android:contentDescription="@string/attachment_icon" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/attachmentTitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#121212"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attachmentCard2"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:orientation="vertical"
            android:background="@drawable/bg_attachments"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/attachment_icon"
                android:contentDescription="@string/attachment_icon" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/attachmentTitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#121212"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attachmentCard3"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:orientation="vertical"
            android:background="@drawable/bg_attachments"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/attachment_icon"
                android:contentDescription="@string/attachment_icon" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/attachmentTitle3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#121212"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#cdcdcd"
        android:layout_marginVertical="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/todays_tasks"
            android:layout_gravity="start"
            android:textSize="14sp"
            android:textColor="#121212"
            android:layout_marginTop="20dp"
            android:textFontWeight="500"
            android:letterSpacing="0.05" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/addTaskButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_button"
            android:paddingHorizontal="20dp"
            android:paddingVertical="4dp"
            android:text="@string/add_task"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/add_task" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tasksContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#cdcdcd"
        android:layout_marginVertical="24dp" />

</LinearLayout>
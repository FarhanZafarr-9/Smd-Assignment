<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Thumbnail or Icon -->
    <ImageView
        android:id="@+id/imageAttachmentThumbnail"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_image_file"
        android:contentDescription="Attachment Thumbnail"
        android:background="@color/tf_bg_screen"
        android:padding="4dp" />

    <!-- Name & Type -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/textAttachmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attachment Name.png"
            android:textColor="@color/tf_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/textAttachmentType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_tag"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Images"
            android:textColor="@color/tf_tag_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Preview Button -->
    <TextView
        android:id="@+id/buttonPreviewAttachment"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="Preview"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/tf_primary"
        android:paddingHorizontal="10dp"
        android:background="?attr/selectableItemBackground" />

    <!-- Remove Icon -->
    <ImageView
        android:id="@+id/buttonRemoveAttachment"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_close"
        android:contentDescription="Remove Attachment"
        android:padding="6dp"
        android:alpha="0.5"
        android:background="?attr/selectableItemBackgroundBorderless" />

</LinearLayout>

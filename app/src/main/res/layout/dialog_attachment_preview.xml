<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header: Title & Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/textPreviewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Attachment Preview"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/textPreviewType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Images"
            android:textColor="#5E35B1"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Image Content Preview -->
    <ImageView
        android:id="@+id/imagePreviewContent"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:scaleType="fitCenter"
        android:background="#F0F0F0"
        android:padding="8dp"
        android:visibility="gone"
        android:contentDescription="Image content preview" />

    <!-- Text Content Preview -->
    <ScrollView
        android:id="@+id/scrollTextPreview"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="#F4F5F7"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textPreviewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#333333"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>

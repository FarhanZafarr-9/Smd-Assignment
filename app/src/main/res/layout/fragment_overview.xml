<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/tf_bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card 1: Project Description & Edit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ABOUT PROJECT"
                    android:textSize="11sp"
                    android:textColor="@color/tf_text_secondary"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/buttonEditProject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit Project"
                    android:textColor="@color/tf_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>

            <TextView
                android:id="@+id/textOverviewDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Project description details..."
                android:textColor="@color/tf_text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Card 2: Overall Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OVERALL PROGRESS"
                    android:textSize="11sp"
                    android:textColor="@color/tf_text_secondary"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/textOverviewPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="33%"
                    android:textColor="@color/tf_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBarOverview"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="33"
                android:progressTint="@color/tf_primary"
                android:progressBackgroundTint="@color/tf_stroke" />

            <TextView
                android:id="@+id/textOverviewFraction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="4 of 12 tasks completed"
                android:textColor="@color/tf_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Card 3: Task Breakdown Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="TASK BREAKDOWN"
            android:textSize="11sp"
            android:textColor="@color/tf_text_secondary"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- 2x2 Breakdown Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- To do Card -->
            <LinearLayout
                android:id="@+id/cardBreakdownTodo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Status dot -->
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/countBreakdownTodo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tf_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="To do"
                    android:textSize="12sp"
                    android:textColor="@color/tf_text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- In progress Card -->
            <LinearLayout
                android:id="@+id/cardBreakdownInProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Status dot -->
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot_inprogress"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/countBreakdownInProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tf_inprogress" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In progress"
                    android:textSize="12sp"
                    android:textColor="@color/tf_text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <!-- Done Card -->
            <LinearLayout
                android:id="@+id/cardBreakdownDone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Status dot -->
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot_done"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/countBreakdownDone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tf_done" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Done"
                    android:textSize="12sp"
                    android:textColor="@color/tf_text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Overdue Card -->
            <LinearLayout
                android:id="@+id/cardBreakdownOverdue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Status dot -->
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot_overdue"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/countBreakdownOverdue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tf_overdue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Overdue"
                    android:textSize="12sp"
                    android:textColor="@color/tf_overdue"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Links Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="QUICK LINKS"
            android:textSize="11sp"
            android:textColor="@color/tf_text_secondary"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/quickLinkAttachments"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/attachment_icon"
                    android:contentDescription="Attachments"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/textQuickLinkAttachments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Attachments (3)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/tf_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quickLinkDiscussion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/comment_icon"
                    android:contentDescription="Discussion"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/textQuickLinkDiscussion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Discussion (3)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/tf_text_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Add Task Button -->
        <Button
            android:id="@+id/buttonOverviewAddTask"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="+ Add Task"
            android:backgroundTint="@color/tf_primary"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
